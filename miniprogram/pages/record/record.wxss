/* 记录页样式 */
.page { padding: 24rpx 24rpx 60rpx; }
.title { font-size: 48rpx; font-weight: 600; margin-bottom: 24rpx; }

/* 分段切换 */
.seg {
  display: flex; background: #EDF1F0; border-radius: 999rpx;
  padding: 8rpx; margin-bottom: 24rpx; width: 300rpx;
}
.seg-btn {
  flex: 1; text-align: center; font-size: 26rpx; color: var(--text2);
  padding: 14rpx 0; border-radius: 999rpx;
}
.seg-btn.on { background: var(--card); color: var(--primary); font-weight: 600; }

/* 统计卡 */
.stat-card { display: flex; align-items: center; gap: 28rpx; }
.donut {
  width: 160rpx; height: 160rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.donut-inner {
  width: 116rpx; height: 116rpx; border-radius: 50%; background: var(--card);
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 600;
}
.nums { flex: 1; min-width: 0; }
.nums .t { font-size: 30rpx; font-weight: 600; }
.nums .d { font-size: 24rpx; color: var(--text2); margin-top: 12rpx; }
.nums .d .b { color: var(--text); }
.nums .d .miss { color: var(--warn); }
.nums .d2 { font-size: 22rpx; color: var(--text2); margin-top: 8rpx; }

/* 分组明细 */
.group-date { font-size: 22rpx; color: var(--text2); margin: 0 4rpx 14rpx; }
.rec { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 26rpx; }
.rec .avatar {
  width: 72rpx; height: 72rpx; border-radius: 16rpx; background: var(--primary-soft);
  display: flex; align-items: center; justify-content: center; font-size: 38rpx; flex-shrink: 0;
}
.rec .meta { flex: 1; min-width: 0; }
.rec .name { font-size: 30rpx; font-weight: 600; }
.rec .type { font-size: 22rpx; color: var(--text2); margin-top: 4rpx; }
.rec .time { font-size: 22rpx; color: var(--text2); flex-shrink: 0; }
.rec .ok {
  width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--done); color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; flex-shrink: 0;
}
.rec .miss-mark {
  width: 44rpx; height: 44rpx; border-radius: 50%; border: 1rpx dashed var(--pending);
  color: var(--pending); display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; flex-shrink: 0;
}
.rec.skipped { opacity: .6; }

/* 概览卡 */
.overview { padding: 8rpx 28rpx; }
.ov-row {
  display: flex; justify-content: space-between; font-size: 26rpx;
  padding: 20rpx 0; border-bottom: 1rpx dashed var(--line);
}
.ov-row:last-child { border-bottom: none; }
.ov-row .b { color: var(--primary); }
