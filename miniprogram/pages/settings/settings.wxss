/* 设置页样式 */
.page { padding: 24rpx 24rpx 60rpx; }
.title { font-size: 48rpx; font-weight: 600; margin-bottom: 24rpx; }

.group {
  background: var(--card); border: 1rpx solid var(--line);
  border-radius: 24rpx; padding: 8rpx 28rpx; margin-bottom: 24rpx;
}
.g-title { font-size: 22rpx; color: var(--text2); padding: 20rpx 0 10rpx; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  gap: 20rpx; padding: 24rpx 0; border-top: 1rpx solid var(--line);
}
.row:first-of-type { border-top: none; }
.label { font-size: 30rpx; }
.label .sub { display: block; font-size: 22rpx; color: var(--text2); margin-top: 6rpx; }
.val { font-size: 24rpx; color: var(--text2); flex-shrink: 0; }

.switch {
  width: 88rpx; height: 48rpx; border-radius: 999rpx; background: #D8DFDC;
  position: relative; transition: background .2s; flex-shrink: 0;
}
.switch::after {
  content: ""; position: absolute; left: 5rpx; top: 5rpx;
  width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff;
  transition: left .2s; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .2);
}
.switch.on { background: var(--primary); }
.switch.on::after { left: 45rpx; }

.btn-line {
  border: 1rpx solid var(--line); color: var(--text2); font-size: 24rpx;
  padding: 12rpx 28rpx; border-radius: 999rpx; flex-shrink: 0;
}
.btn-danger-line {
  border: 1rpx solid var(--danger); color: var(--danger); font-size: 24rpx;
  padding: 12rpx 28rpx; border-radius: 999rpx; flex-shrink: 0;
}
